# Extra post-remove for nosh-kbd-shims
# vim: set filetype=sh:

for i in chvt clear_console resizecons
do
	dpkg-divert --package nosh-kbd-shims --rename --remove /usr/bin/"${i}"
	dpkg-divert --package nosh-kbd-shims --rename --divert /usr/share/man/man1/"${i}".distrib.1.gz --remove /usr/share/man/man1/"${i}".1.gz
done
