# Extra pre-upgrade for nosh-systemv-shims
# vim: set filetype=sh:

for i in emergency halt haltsys initctl-read normal powercycle poweroff reboot rescue runlevel shutdown telinit
do
	dpkg-divert --package nosh-systemv-shims --rename --add /usr/sbin/"${i}"
	dpkg-divert --package nosh-systemv-shims --rename --divert /usr/share/man/man8/"${i}".distrib.8.gz --add /usr/share/man/man8/"${i}".8.gz
done
for i in init
do
	dpkg-divert --package nosh-systemv-shims --rename --add /usr/sbin/"${i}"
	dpkg-divert --package nosh-systemv-shims --rename --divert /usr/share/man/man1/"${i}".distrib.1.gz --add /usr/share/man/man1/"${i}".1.gz
done
