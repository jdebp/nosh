# Extra post-remove for nosh-openrc-shims
# vim: set filetype=sh:

for i in rc-service rc-update
do
	dpkg-divert --package nosh-openrc-shims --rename --remove /usr/bin/"${i}"
	dpkg-divert --package nosh-openrc-shims --rename --divert /usr/share/man/man8/"${i}".distrib.8.gz --remove /usr/share/man/man8/"${i}".8.gz
done
