# Extra pre-install for nosh-net-tools-shims
# vim: set filetype=sh:

for i in ifconfig
do
	dpkg-divert --package nosh-net-tools-shims --rename --add /usr/bin/"${i}"
	dpkg-divert --package nosh-net-tools-shims --rename --divert /usr/share/man/man1/"${i}".distrib.1.gz --add /usr/share/man/man1/"${i}".1.gz
done
