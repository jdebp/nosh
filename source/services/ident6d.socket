[Unit]
Description=IDENT socket capable of single-stack IPV6 and IPV6-mapped IPV4

[Socket]
Backlog=1
ListenStream=113
Accept=true
MaxConnections=2
UCSPIRules=true
LogUCSPIRules=yes
NoDelay=false
BindIPv6Only=both

[Install]
WantedBy=server.target
